# Copy to `.env` and fill in. Every value here has a working default, so the
# app runs with no .env at all -- it just uses the offline stub model.

# ---------------------------------------------------------------------------
# LLM provider: gemini | groq | ollama | stub
# ---------------------------------------------------------------------------
# `stub` is the default: deterministic, offline, no key. Good for tests and for
# seeing the UI work. Switch to `gemini` for real answers.
LLM_PROVIDER=gemini

# Gemini -- free tier, no credit card. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq -- also free, no card. Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama -- fully local, nothing leaves the machine.
#   ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Embeddings -- runs locally, no key. Set to `hashing` for a fast, offline,
# lower-quality embedder that needs no model download (used by the tests).
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Retrieval and chunking -- see README for the reasoning behind the defaults.
# ---------------------------------------------------------------------------
CHUNK_TARGET_WORDS=120
CHUNK_OVERLAP_WORDS=30
RETRIEVAL_TOP_K=6
RETRIEVAL_DENSE_WEIGHT=0.65
CONTEXT_MAX_WORDS=1800

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
# `json` for production log shipping, `console` for readable local output.
LOG_FORMAT=console
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_BYTES=5242880
MAX_JOBS_PER_SESSION=10
SESSION_TTL_SECONDS=14400
